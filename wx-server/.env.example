# ===== 应用 =====
NODE_ENV=production
PORT=3000

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wx_app
DB_PASSWORD=替换为强密码
DB_NAME=wx_shop

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ===== JWT =====
# 生成随机密钥: openssl rand -hex 32
JWT_SECRET=请替换为32字节以上随机串
JWT_EXPIRES_IN=7d

# ===== 微信小程序（上线前替换为真实值）=====
WX_APPID=你的小程序AppID
WX_SECRET=你的小程序AppSecret
WX_MOCK_LOGIN=false

# ===== 上传 =====
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://api.yourdomain.com

# ===== 门店（默认门店）=====
DEFAULT_STORE_ID=1