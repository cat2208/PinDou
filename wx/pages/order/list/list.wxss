/* pages/order/list/list.wxss */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
}
.tab.active { background: var(--brand); color: #fff; font-weight: 600; }

.o-card { padding: 20rpx 24rpx; }
.o-head { display: flex; justify-content: space-between; align-items: center; }
.o-head-left { display: flex; align-items: center; min-width: 0; }
.type-tag {
  flex-shrink: 0; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx;
  margin-right: 12rpx; font-weight: 600;
}
.type-custom { background: #FFF3E0; color: #E65100; }
.type-store { background: #E8F5E9; color: #2E7D32; }
.type-mall { background: #E3F2FD; color: #1565C0; }
.o-no { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; }
.o-body { display: flex; align-items: center; margin-top: 16rpx; }
.o-img {
  width: 120rpx; height: 120rpx;
  border-radius: var(--radius);
  background: #FFF0E4;
  margin-right: 16rpx;
}
.o-img-ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; background: #FFF7EC; border: 1rpx dashed #F0E4D2;
}
.o-img-store { background: #F0FFF4; border-color: #DCF4E3; }
.o-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.o-title {
  font-size: 28rpx; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.o-amount { margin-left: 12rpx; }
.o-foot { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.mini { font-size: 24rpx; padding: 8rpx 28rpx; }
.go-btn { margin-top: 32rpx; }