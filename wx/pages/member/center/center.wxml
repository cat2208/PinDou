<!--pages/member/center/center.wxml 会员中心-->
<view class="page fade-in" wx:if="{{member}}">
  <!-- 头部会员卡 -->
  <view class="hero">
    <view class="hero-row">
      <view class="avatar">拼</view>
      <view class="hero-info">
        <text class="hero-level">{{member.levelName}}</text>
        <text class="hero-sub">会员等级 Lv.{{member.level}}</text>
      </view>
    </view>
    <view class="hero-nums">
      <view class="hero-num" bindtap="goPoints">
        <text class="num">{{member.points}}</text>
        <text class="num-label">积分</text>
      </view>
      <view class="hero-num">
        <text class="num">¥{{member.balance}}</text>
        <text class="num-label">余额</text>
      </view>
    </view>
    <view class="growth">
      <view class="growth-bar"><view class="growth-fill" style="width: {{member.growth.rate * 100}}%"></view></view>
      <text class="growth-tip">再成长 {{member.growth.next - member.growth.current}} 积分升级金卡</text>
    </view>
  </view>

  <!-- 权益列表 -->
  <view class="card menu">
    <view class="menu-item" bindtap="goOrders"><text>我的订单</text><text class="arrow">›</text></view>
  </view>

  <view class="card menu">
    <view class="menu-item"><text>会员说明</text><text class="arrow">›</text></view>
    <view class="menu-item"><text>积分规则</text><text class="arrow">›</text></view>
  </view>
  <view class="safe-bottom" />
</view>