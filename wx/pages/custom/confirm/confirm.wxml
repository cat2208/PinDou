<!--pages/custom/confirm/confirm.wxml 来图定制-确认下单-->
<view class="page fade-in" wx:if="{{order}}">
  <view class="card">
    <view class="step">STEP 4 · 确认订单</view>
    <view class="order-row">
      <image class="order-img" src="{{order.image}}" mode="aspectFit" />
      <view class="order-info">
        <text class="order-name">来图定制 · {{order.size}}</text>
        <text class="sub">数量 × {{order.qty}}</text>
        <text class="sub">预计 {{order.deliveryDay}} 天内发货</text>
      </view>
    </view>
    <view class="divider" />
    <view class="order-row between">
      <text class="sub">订单编号</text>
      <text class="order-no">{{order.orderNo}}</text>
    </view>
  </view>

  <!-- 拼豆图纸摘要（定制单带图纸时展示） -->
  <view class="card" wx:if="{{order.patternId}}">
    <view class="step">拼豆图纸</view>
    <view class="order-row">
      <image class="order-img" src="{{order.patternUrl}}" mode="aspectFit" />
      <view class="order-info">
        <text class="order-name">{{order.size}} · {{order.beadSize}}mm 豆</text>
        <text class="sub">{{order.gridWidth}}×{{order.gridHeight}} 网格 · {{order.totalBeans}} 颗豆</text>
        <text class="sub">{{order.colorCount}} 色 · {{order.style === 'REALISTIC' ? '写实' : '卡通'}} 风格</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-value input" placeholder="怎么称呼您" value="{{contact}}"
        bindinput="onContactInput" maxlength="20" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-value input" type="number" placeholder="用于接收制作进度" value="{{phone}}"
        bindinput="onPhoneInput" maxlength="11" />
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">补充说明</text>
      <textarea class="remark" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" auto-height maxlength="200" />
    </view>
  </view>

  <view class="pay-bar">
    <view class="pay-total">
      <text class="sub">合计</text>
      <text class="price"><text class="price-symbol">¥</text><text class="price-int">{{order.totalPrice}}</text></text>
    </view>
    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">提交订单</button>
  </view>
  <view class="pay-bar-placeholder" />
</view>