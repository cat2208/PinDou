/* pages/custom/upload/upload.wxss */
.step {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.upload-box {
  border: 2rpx dashed #EAD3B8;
  border-radius: var(--radius-lg);
  background: #FFF9F1;
  min-height: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-plus { font-size: 72rpx; color: var(--brand); line-height: 1; }
.upload-text { font-size: 30rpx; color: var(--text-main); margin-top: 16rpx; }
.upload-sub { font-size: 24rpx; color: var(--text-light); margin-top: 8rpx; }

.upload-preview { position: relative; }
.preview-img {
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius);
  background: #FFF0E4;
}
.preview-actions { margin-top: 16rpx; text-align: center; }
.mini { font-size: 24rpx; padding: 8rpx 28rpx; }

.picker { color: var(--text-main); }
.form-tip { font-size: 22rpx; color: var(--text-light); margin-top: 6rpx; line-height: 1.4; }
.custom-grid { display: flex; align-items: center; }
.grid-input {
  width: 140rpx; height: 64rpx;
  border: 1rpx solid #E0CDB2;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  background: #fff;
}
.grid-x { margin: 0 20rpx; color: var(--text-light); font-size: 28rpx; }
.grid-unit { margin-left: 12rpx; color: var(--text-light); font-size: 26rpx; }
.qty { display: flex; align-items: center; }
.qty-btn {
  width: 60rpx; height: 60rpx;
  border: 1rpx solid #E0CDB2;
  border-radius: 12rpx;
  text-align: center;
  line-height: 58rpx;
  font-size: 32rpx;
  color: var(--brand);
  background: #fff;
}
.qty-num { width: 96rpx; text-align: center; font-size: 32rpx; font-weight: 700; }
.column { flex-direction: column; align-items: stretch; }
.remark {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  background: #FAF5EC;
  border-radius: var(--radius);
  padding: 16rpx;
  box-sizing: border-box;
}
.next { margin-top: 8rpx; }