/* pages/index/index.wxss */
.banner {
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.banner-img {
  width: 100%;
  height: 100%;
  background: #FFE8D6;
}

.brand-hero {
  background: linear-gradient(135deg, #FF9A5A, #E86A33);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}
.brand-title { font-size: 40rpx; font-weight: 700; }
.brand-slogan { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }

.cat-grid { margin-bottom: 24rpx; }
.cat-item {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(232, 106, 51, 0.08);
}
.cat-icon { font-size: 56rpx; }
.cat-name { font-size: 26rpx; margin-top: 12rpx; font-weight: 600; }

.store-card { display: flex; align-items: center; justify-content: space-between; }
.store-left { display: flex; flex-direction: column; flex: 1; margin-right: 16rpx; }
.store-arrow { font-size: 48rpx; color: var(--text-light); }

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 20rpx;
}

.product-card { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.product-img {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius);
  background: #FFF0E4;
  margin-bottom: 16rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.mini { font-size: 22rpx; padding: 8rpx 20rpx; }