<!--pages/mall/cart/cart.wxml 购物车-->
<view class="page fade-in">
  <view wx:if="{{items.length}}" class="cart-list">
    <view class="card c-item" wx:for="{{items}}" wx:key="id">
      <view class="check {{item.checked ? 'on' : ''}}" bindtap="toggleItem" data-index="{{index}}">
        <text wx:if="{{item.checked}}">✓</text>
      </view>
      <view class="c-info">
        <text class="c-name">{{item.name}}</text>
        <view class="c-foot">
          <text class="price"><text class="price-symbol">¥</text>{{item.price}}</text>
          <view class="qty">
            <text class="qty-btn" bindtap="changeQty" data-index="{{index}}" data-delta="-1">－</text>
            <text class="qty-num">{{item.qty}}</text>
            <text class="qty-btn" bindtap="changeQty" data-index="{{index}}" data-delta="1">＋</text>
          </view>
        </view>
      </view>
      <text class="c-del" bindtap="removeItem" data-index="{{index}}">✕</text>
    </view>
  </view>
  <view wx:else class="empty">
    <text>购物车还是空的</text>
    <button class="btn-outline go-btn" bindtap="goMall">去逛逛</button>
  </view>

  <view wx:if="{{items.length}}" class="checkout-bar">
    <view class="all-check" bindtap="toggleAll">
      <view class="check {{allChecked ? 'on' : ''}}"><text wx:if="{{allChecked}}">✓</text></view>
      <text>全选</text>
    </view>
    <view class="total">
      <text class="sub">合计</text>
      <text class="price"><text class="price-symbol">¥</text><text class="price-int">{{totalPrice}}</text></text>
    </view>
    <button class="btn-primary" bindtap="checkout">结算({{selectedCount}})</button>
  </view>
  <view wx:if="{{items.length}}" class="checkout-bar-placeholder" />
</view>