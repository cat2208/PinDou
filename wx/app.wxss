/**app.wxss 拼豆手工店 - 全局样式基调（暖橙拼豆品牌色）**/
page {
  --brand: #E86A33;
  --brand-dark: #C9501F;
  --brand-light: #FFF7EC;
  --accent: #FFB547;
  --text-main: #3A3229;
  --text-sub: #9B917F;
  --text-light: #C9BFAC;
  --bg: #FFF7EC;
  --card-bg: #FFFFFF;
  --success: #4CAF50;
  --danger: #E53935;
  --warning: #FB8C00;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea, image, scroll-view {
  box-sizing: border-box;
}

/* 通用容器 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
}

/* 卡片 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(232, 106, 51, 0.08);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF9A5A, #E86A33);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  opacity: 0.5;
  color: #fff;
}

/* 次按钮 */
.btn-outline {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  line-height: 1.4;
}
.btn-outline::after { border: none; }

/* 价格 */
.price { color: var(--brand); font-weight: 700; }
.price-symbol { font-size: 24rpx; }
.price-int { font-size: 40rpx; }

/* 标题与文字 */
.title { font-size: 34rpx; font-weight: 700; color: var(--text-main); }
.sub { font-size: 26rpx; color: var(--text-sub); }
.danger { color: var(--danger); }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--brand);
  background: #FFEFE3;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 8rpx;
}

/* 状态徽标 */
.badge {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.badge-success { background: #E8F5E9; color: #2E7D32; }
.badge-warning { background: #FFF3E0; color: #E65100; }
.badge-danger { background: #FFEBEE; color: #C62828; }
.badge-info { background: #E3F2FD; color: #1565C0; }
.badge-gray { background: #F5F5F5; color: #757575; }

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
}

/* 底部安全区留白 */
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }

/* 骨架屏淡入 */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fadeInUp 0.3s ease both; }

/* 表单通用 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3EDE3;
}
.form-label { width: 180rpx; color: var(--text-sub); font-size: 28rpx; }
.form-value { flex: 1; }
.input {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-main);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F3EDE3;
  margin: 20rpx 0;
}

/* 两列网格 */
.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-2 > view { width: calc(50% - 12rpx); }

/* 横向滚动分类 */
.h-scroll {
  display: flex;
  white-space: nowrap;
  overflow-x: auto;
  padding: 8rpx 0 16rpx;
}
.h-scroll::-webkit-scrollbar { display: none; }